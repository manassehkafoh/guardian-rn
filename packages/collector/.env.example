# Docker Compose Example Environment Variables
# Copy this file to .env and fill in the values securely.
# WARNING: Do not use default or easy-to-guess passwords in production environments.

# Password for the built-in 'elastic' user in Elasticsearch
ELASTIC_PASSWORD=changeme-securely

# Password used by Logstash and Kibana to connect to Elasticsearch
ELASTICSEARCH_PASSWORD=changeme-securely

# Admin password for Grafana dashboard access
GF_SECURITY_ADMIN_PASSWORD=admin-secure
